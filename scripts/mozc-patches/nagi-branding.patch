diff --git a/src/base/mac/mac_util.mm b/src/base/mac/mac_util.mm
index 6ca6fc4..de99a29 100644
--- a/src/base/mac/mac_util.mm
+++ b/src/base/mac/mac_util.mm
@@ -63,7 +63,14 @@ const unsigned char kPrelauncherPath[] =
 #ifdef GOOGLE_JAPANESE_INPUT_BUILD
 const char kProjectPrefix[] = "com.google.inputmethod.Japanese.";
 #elif defined(MOZC_BUILD)
-const char kProjectPrefix[] = "org.mozc.inputmethod.Japanese.";
+// nagi (M2b): this literal, not config.bzl's MACOS_BUNDLE_ID_PREFIX, is
+// what ipc/mach_ipc.cc's GetMachPortName() actually uses to compute the
+// launchd Mach service name at runtime (MacUtil::GetLabelForSuffix ->
+// kProjectPrefix + "Converter.session"). config.bzl only reaches
+// Info.plist bundle IDs, not this constant — the two are independent
+// despite looking related. Must match the LaunchAgent plist's
+// MachServices key and MozcClient's serviceName in nagi's app/ exactly.
+const char kProjectPrefix[] = "com.nvleo.inputmethod.nagi.";
 #else  // GOOGLE_JAPANESE_INPUT_BUILD, MOZC_BUILD
 #error Unknown branding
 #endif  // GOOGLE_JAPANESE_INPUT_BUILD, MOZC_BUILD
