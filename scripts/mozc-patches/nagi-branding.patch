 BAZEL_TOOLS_PREFIX = "@bazel_tools"
 
@@ -48,7 +48,7 @@ IBUS_MOZC_PATH = "/usr/lib/ibus-mozc/ibus-engine-mozc"
 EMACS_MOZC_CLIENT_DIR = "/usr/share/emacs/site-lisp/emacs-mozc"
