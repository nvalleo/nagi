<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleDisplayName</key>
	<string>Nagi</string>
	<key>CFBundleExecutable</key>
	<string>Nagi</string>
	<!-- #25: Dock/Finder icon. Generated from scripts/icons/ (see
	     scripts/build-icons.sh) — .icns referenced without its extension
	     is the more common convention, but modern Xcode-generated
	     Info.plists include it and both are documented as valid, so kept
	     explicit here for clarity. -->
	<key>CFBundleIconFile</key>
	<string>Nagi.icns</string>
	<key>CFBundleIdentifier</key>
	<!-- Draft bundle ID from issue #1 — not finalized. Must contain the
	     literal substring ".inputmethod." — confirmed by bisecting
	     against known-working IMKit bundles (every one of them,
	     Apple's own and third-party, uses this token) and finding the
	     literal string embedded in imklaunchagent/HIToolbox's string
	     table. Bundle IDs without it are silently never added to the
	     Text Input Source registry, no matter what else is correct. -->
	<string>com.nvleo.inputmethod.nagi</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Nagi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.1</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- No LSBackgroundOnly — Apple's own bundled IMKit hosts (e.g.
	     /System/Library/Input Methods/AinuIM.app) declare only
	     LSUIElement, not both. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 nv-leo</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsSuddenTermination</key>
	<true/>
	<key>InputMethodConnectionName</key>
	<string>Nagi_1_Connection</string>
	<!-- ControllerClass only — neither AinuIM nor macSKK (both confirmed
	     working) declare DataSourceClass/DelegateClass, so we dropped
	     them to match the known-good pattern. -->
	<key>InputMethodServerControllerClass</key>
	<string>NagiInputController</string>
	<key>TISIntendedLanguage</key>
	<string>ja</string>
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hira</string>
		<string>Latn</string>
	</array>
	<key>tsInputMethodIconFileKey</key>
	<string>nagi.tiff</string>
	<!-- #30 follow-up: System Settings > Keyboard > Input Sources' own
	     list row icon turned out to read neither this key nor
	     tsInputModeMenuIconFileKey below — confirmed by
	     JapaneseIM-RomajiTyping.app (Kotoeri) having *no* icon keys at
	     all yet still showing correctly there. It reads TISIconLabels >
	     CustomIcon instead (only AinuIM.app, of everything bundled with
	     macOS, sets this), and TISIconIsTemplate must be true — a plain
	     black-on-transparent glyph the system tints itself, hence a
	     separate asset (Nagi-template.pdf) from nagi.tiff's colored
	     badge, which remains what the menu bar Input menu uses. Without
	     this, Nagi's row fell back to some generic system glyph instead
	     of its own mark.

	     #35 follow-up: dropping this flag entirely (to keep nagi.tiff's
	     real color in the menu bar, Google 日本語入力-style — it sets
	     neither this nor CustomIcon) was tried on real hardware. Broke
	     the list row above back to a blank icon without fixing the menu
	     bar badge, which stayed blank regardless — so keep this flag.
	     This list row itself re-reads its icon live — every asset swap
	     during that investigation (re-signing + relaunching Nagi, no
	     logout) was reflected here immediately, working or broken. The
	     menu bar badge is the one that didn't: unrelated to this flag or
	     nagi.tiff's format, it turned out to need an actual login, like
	     every other Text Input Source change in this app (see
	     InputSourceRegistration.swift's file header) — a *changed* icon
	     for an *already-registered* source doesn't get picked up by
	     relaunching Nagi or toggling other input sources, only by the
	     next login. Confirmed on real hardware — the menu bar badge
	     rendered correctly after a real logout/login, once nagi.tiff was
	     redrawn as an alpha-cutout matching AinuIM.app's own Ainu.tiff
	     (see scripts/icons/generate.py) with
	     correct HiDPI tagging (scripts/icons/mktiff.swift). -->
	<key>TISIconIsTemplate</key>
	<true/>
	<!-- M1 is a single romaji->hiragana mode, on purpose — no katakana /
	     half-width / full-width-roman variants yet. Compare
	     google/mozc's mac/Info.plist (five modes) once M2 lands real
	     conversion and those modes start meaning something.
	     tsInputModePrimaryInScriptKey=false, mirroring AinuIM, so this
	     doesn't claim to be *the* primary handler for smJapanese
	     (Kotoeri/Google already do) while still being independently
	     selectable. -->
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>com.nvleo.inputmethod.nagi.Hiragana</key>
			<dict>
				<key>TISIconLabels</key>
				<dict>
					<key>CustomIcon</key>
					<string>Nagi-template.pdf</string>
				</dict>
				<key>TISInputSourceID</key>
				<string>com.nvleo.inputmethod.nagi.Hiragana</string>
				<key>TISIntendedLanguage</key>
				<string>ja</string>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>nagi.tiff</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<false/>
				<key>tsInputModeScriptKey</key>
				<string>smJapanese</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>com.nvleo.inputmethod.nagi.Hiragana</string>
		</array>
	</dict>
</dict>
</plist>
